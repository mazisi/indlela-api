<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Postgres, as in production: the Sail pgsql service's indlela_testing
             database (created on first start). Host and port come from .env
             (pgsql:5432 inside Sail); from the host, override DB_HOST/DB_PORT.
             tests/TestCase.php refuses anything that isn't a local test database. -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="indlela_testing" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="FILESYSTEM_DISK" value="s3"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="AUTH_PIN_ENABLED" value="true" force="true"/>
        <env name="SMS_DRIVER" value="log"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="GSC_QUEUE_CONNECTION" value="sync"/>
        <env name="AUDIT_QUEUE_CONNECTION" value="sync"/>
        <env name="AUDIT_DELAY_MS" value="0"/>
        <env name="PAGESPEED_API_KEY" value=""/>
        <env name="RANK_QUEUE_CONNECTION" value="sync"/>
        <env name="RANK_LOCATIONS_QUEUE_CONNECTION" value="sync"/>
        <env name="DATAFORSEO_LOGIN" value="" force="true"/>
        <env name="DATAFORSEO_PASSWORD" value="" force="true"/>
        <env name="DATAFORSEO_SANDBOX" value="true" force="true"/>
        <env name="INDLELA_PLATFORM_WORKSPACE" value="" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
