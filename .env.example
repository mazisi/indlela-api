APP_NAME="Indlela"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Where the API answers (Sail serves it on APP_PORT).
APP_URL=http://localhost:8000
APP_PORT=8000
# The SPA (indlela): reset links and email buttons point here; CORS allows it.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_TIMEZONE=Africa/Johannesburg

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inside Sail the host is the `pgsql` service. Host-side tools (TablePlus,
# psql) use localhost:FORWARD_DB_PORT.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=indlela
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The SPA signs in with Bearer tokens (no cookies), so this only matters if
# someone later switches to Sanctum's cookie mode.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
# Jobs run on Redis under Horizon (`sail artisan horizon`, dashboard /horizon).
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit catches everything locally: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@indlela.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage: the `minio` Sail service locally (S3-compatible; console
# http://localhost:9001, sail / password). Bucket: `sail artisan storage:bucket`.
# In production: real S3 keys, AWS_ENDPOINT and AWS_URL empty, path style false.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=indlela
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/indlela
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Host ports for the Sail services (move them if another project uses one) ---
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001

# --- Authentication (see config/indlela.php) ---
AUTH_MAX_FAILED_ATTEMPTS=5
# One-time PIN after the password. false = sign straight in.
AUTH_PIN_ENABLED=true
AUTH_PIN_TTL_MINUTES=5
AUTH_PIN_MAX_ATTEMPTS=3
AUTH_PIN_MAX_RESENDS=5
AUTH_PIN_RESEND_COOLDOWN=30
AUTH_RESET_TTL_MINUTES=60
AUTH_INVITE_TTL_HOURS=72

# --- SMS for sign-in PINs ---
# log = write to the log (local); twilio = send for real.
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- First Owner and workspace (database/seeders/UserSeeder.php) ---
SEED_ADMIN_EMAIL=admin@indlela.local
SEED_ADMIN_NAME=Indlela
SEED_ADMIN_SURNAME=Admin
SEED_ADMIN_MOBILE=
# Leave empty to generate a random one (printed once by the seeder).
SEED_ADMIN_PASSWORD=
SEED_WORKSPACE_NAME="Indlela Demo"

# Who may open /horizon outside local (comma-separated). Locally it is open.
HORIZON_ADMIN_EMAILS=

# --- Google Search Console (README: "Google Cloud set-up") ---
# The redirect URI must be listed exactly under the OAuth client's "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# --- Site audit (README: "Site audit") ---
# PageSpeed Insights API key (optional; same Google Cloud project, enable "PageSpeed Insights API").
# Without it Core Web Vitals use Google's shared quota and are often "unavailable".
PAGESPEED_API_KEY=
# Crawler politeness: requests in flight, timeout (s), pause between batches (ms).
AUDIT_CONCURRENCY=4
AUDIT_TIMEOUT=10
AUDIT_DELAY_MS=250

# --- Rank tracking (README: "Rank tracking") ---
# DataForSEO API login and password (dashboard > API access): the platform's one account, never
# configured by workspaces. Sandbox = free sample data, no real SERPs.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_SANDBOX=true
# Beta limits: active keywords per workspace (workspaces.rank_keyword_limit overrides), "check now"
# per workspace per day (SAST), platform-wide monthly DataForSEO spend in USD (0 = no cap).
RANK_WORKSPACE_KEYWORD_LIMIT=500
RANK_CHECK_NOW_DAILY_LIMIT=20
RANK_MONTHLY_SPEND_CAP_USD=50
# DataForSEO location list download (~270k places): memory for that job/command.
RANK_LOCATIONS_MEMORY_LIMIT=1024M

# --- Local map pack grid (README: "Local map pack grid") ---
# Same DataForSEO account; its spend counts toward RANK_MONTHLY_SPEND_CAP_USD.
# Beta limits per workspace: active grids, manual scans and business searches a day (SAST).
LOCAL_GRID_MAX_GRIDS=10
LOCAL_GRID_SCAN_NOW_DAILY_LIMIT=10
LOCAL_GRID_SEARCH_DAILY_LIMIT=30
# Expected price of one live Maps call (USD), for the cap's pending spend.
LOCAL_GRID_PRICE_LIVE=0.002
# LOCAL_GRID_QUEUE_CONNECTION=redis

# White-label reports: generation (dompdf) runs on the long-job queue; the
# monthly email goes out from MAIL_FROM_ADDRESS with the workspace as the sender name.
# REPORTS_QUEUE_CONNECTION=redis-long

# --- Platform (README: "Platform usage (Indlela staff)") ---
# Slug of the Indlela staff workspace: the only one with Platform › Usage (DataForSEO spend and every
# workspace's usage). Run `php artisan db:seed --class=RolePermissionSeeder` after setting it. Empty = off.
INDLELA_PLATFORM_WORKSPACE=
